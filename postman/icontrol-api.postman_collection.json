{
  "info": {
    "name": "iControl API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"usuario@ejemplo.com\",\n  \"password\": \"password\",\n  \"device_name\": \"Postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/api/login"
          }
        }
      ]
    },
    {
      "name": "CRUD de recursos",
      "item": [
        {
          "name": "Listar conductores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/conductores"
          }
        },
        {
          "name": "Crear conductor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"telefono\": \"70000000\",\n  \"correo\": \"ana@example.com\",\n  \"ci\": \"1234567\",\n  \"estado\": \"activo\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/api/conductores"
          }
        }
      ]
    }
  ]
}
